        201,
        202,
        203
    ],
    "scenario": {
        "simulated_days": 14,
        "sessions_per_project": 120,
        "forced_p90_sessions": 3
    },
    "stopping_rule": {
        "kind": "fixed_n",
        "paired_items_per_probe_type": 120,
        "cusum": [
            {
                "kind": "harm",
                "metric": "harm",
                "k": "0.5",
                "h": "4"
            },
            {
                "kind": "futility",
                "metric": "probe-P1",
                "k": "0.5",
                "h": "5"
            }
        ]
    },
    "missingness_policy": {
        "in_flight_at_interrupt": "failed(interrupted)",
        "failed_turn_items": "exclude-from-recall-and-count",
        "excluded_counts_reported_per_arm": true,
        "failed_items_counted_in": "dependability"
    },
    "divergence_policy": {
        "hash_input": "normalised-last-agent-output",
        "normalisation": [
            "iso-8601-timestamps",
            "durations",
            "pids",
            "temp-paths",
            "run-ids"
        ],
        "diagnostic_hash": "agent-visible-prefix",
        "on_divergence": "record-then-live"
    },
    "liveness_bounds": {
        "turn_deadline_ms": 900000,
        "job_deadline_ms": 1200000,
        "tier_wall_budget_ms": 36000000
    },
    "bootstrap": {
        "replicates": 2000,
        "seed": 2001
    },
    "leak_bound": {
        "c_bytes_per_session": 8388608,
        "r2_threshold": "0.8",
