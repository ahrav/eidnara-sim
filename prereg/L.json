        "pi",
        "opencode"
    ],
    "seeds": [
        301,
        302,
        303
    ],
    "scenario": {
        "simulated_days": 42,
        "sessions_per_project": 400,
        "forced_p90_sessions": 3
    },
    "stopping_rule": {
        "kind": "fixed_n",
        "paired_items_per_probe_type": 150,
        "cusum": [
            {
                "kind": "harm",
                "metric": "harm",
                "statistic": "the maximum over the five harm metrics of the paired difference eidnara minus host, one value per completed paired item in issue order",
                "sd_source": "the M tier's A/A pairs",
                "k": "0.5",
                "h": "4"
            },
            {
                "kind": "futility",
                "metric": "probe-P1",
                "statistic": "the paired difference host minus eidnara on probe-P1, one value per completed paired item in issue order",
                "sd_source": "the M tier's A/A pairs",
                "k": "0.5",
                "h": "5"
            }
        ]
    },
    "missingness_policy": {
        "in_flight_at_interrupt": "failed(interrupted)",
