{
    "schema": "sim-prereg/v1",
    "tier": "XL",
    "revision": 5,
    "frozen": true,
    "arms": {
        "default": "eidnara",
        "run": [
            "host",
            "eidnara"
        ],
        "order_by_seed": [
            [
                "host",
                "eidnara"
            ]
        ]
    },
    "hosts": [
        "pi",
        "opencode"
    ],
    "seeds": [
        401
    ],
    "scenario": {
        "simulated_days": 120,
        "sessions_per_project": 1500,
        "forced_p90_sessions": 3,
        "cue_probe_similarity": {
            "bm25_max": "0.4",
            "cosine_max": "0.6",
            "embedding_model": "amazon.titan-embed-text-v2:0"
        }
    },
    "stopping_rule": {
        "kind": "fixed_n",
        "paired_items_per_probe_type": 60,
        "cusum": []
    },
    "missingness_policy": {
        "in_flight_at_interrupt": "failed(interrupted)",
        "failed_turn_items": "exclude-from-recall-and-count",
        "excluded_counts_reported_per_arm": true,
        "failed_items_counted_in": "dependability"
    },
    "divergence_policy": {
        "hash_input": "normalised-last-agent-output",
        "normalisation": [
            "iso-8601-timestamps",
            "durations",
            "pids",
            "temp-paths",
            "run-ids"
        ],
        "diagnostic_hash": "agent-visible-prefix",
        "on_divergence": "record-then-live"
    },
    "liveness_bounds": {
        "turn_deadline_ms": 900000,
        "job_deadline_ms": 1200000,
        "tier_wall_budget_ms": 345600000,
        "daemon_busy_cpu_fraction": "0.05"
    },
    "bootstrap": {
        "replicates": 2000,
        "seed": 4001
    },
    "leak_bound": {
        "c_bytes_per_session": 8388608,
        "r2_threshold": "0.8",
        "sample_interval_ms": 10000
    },
    "grading": {
        "first_attempt_only": true,
        "lookup_match": "whole-word",
        "abstain_rule": "leading-UNKNOWN",
        "p11_false_positive_weight": "2",
        "p13_reduction_ratio": {
            "min": "0.02",
            "max": "0.5"
        },
        "judge": {
            "model": "global.openai.gpt-5.6-luna",
            "cross_judge": "global.anthropic.claude-haiku-5-5",
            "calibration_min_pairs": 20,
            "human_sample_percent": 10,
            "arm_identification_ceiling_percent": 60
        }
    },
    "oracles": {
        "hang_quiet_ms": 300000,
        "cost_ratio_max": "1.5"
    },
    "families": [
        {
            "id": "probe-P1",
            "metrics": [
                "P1.pass"
            ],
            "outcome": "binary",
            "treatment_unit": "run",
            "analysis_unit": "item",
            "cluster_key": "ledger_fact_id",
            "direction": "descriptive",
            "margin": {
                "value": "0",
                "scale": "pp"
            },
            "mde": {
                "value": "18",
                "scale": "pp"
            },
            "power": "0.8",
            "alpha": "0.05",
            "interval_method": "exact-mcnemar-newcombe-cluster-bootstrap",
            "multiplicity": "none",
            "claim": "descriptive",
            "min_paired_runs": 1
