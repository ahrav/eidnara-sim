{
    "name": "eidnara-sim",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "scripts/forbid-comment-markers.sh && biome check .",
        "lint:fix": "biome check --write .",
        "test": "bun test",
        "prereg:validate": "bun scripts/validate-prereg.ts",
        "catalog:check": "bun scripts/check-catalog.ts",
        "check": "bun run typecheck && bun run lint && bun run test && bun run prereg:validate && bun run catalog:check"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.1",
        "@types/bun": "1.3.14",
        "@types/node": "^22.20.0",
        "typescript": "5.9.3"
    }
}
