+/*
+ * Under FAKETIME_DONT_FAKE_MONOTONIC=1 a monotonic-family clock is the kernel's clock at
+ * every call, before and after ftpl_init().
+ */
+static bool ft_clock_stays_real(clockid_t clk_id)
+{
+  int fake = fake_monotonic_clock;
+
+  if (clk_id != CLOCK_MONOTONIC && clk_id != CLOCK_MONOTONIC_RAW
