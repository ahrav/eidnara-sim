+      && clk_id != CLOCK_MONOTONIC_COARSE
+#endif
+#ifdef CLOCK_BOOTTIME
+      && clk_id != CLOCK_BOOTTIME
+#endif
+      )
+  {
+    return false;
+  }
+  get_fake_monotonic_setting(&fake);
+  return !fake;
+}
+#endif
